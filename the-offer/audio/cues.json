 "lines": [
  {
   "id": "except",
   "t0": 14.53125,
   "t1": 18.04688,
   "text": "— except yourself."
  },
  {
   "id": "ninety",
   "t0": 21.79688,
   "t1": 24.14063,
   "text": "Ninety-nine others have received this offer."
  },
  {
   "id": "they",
   "t0": 24.375,
   "t1": 26.71875,
   "text": "They will know exactly how to use it."
  },
  {
   "id": "you",
   "t0": 27.1875,
   "t1": 29.88281,
   "text": "You will not."
  },
  {
   "id": "dlabel",
   "t0": 30.23438,
   "t1": 37.26563,
   "text": "DECLINE"
  },
  {
   "id": "nothing",
   "t0": 30.70313,
   "t1": 32.92969,
   "text": "Nothing happens."
  },
  {
   "id": "anyone",
   "t0": 32.92969,
   "t1": 35.625,
   "text": "But anyone can stop the world, and you would never know."
  },
  {
   "id": "alabel",
   "t0": 35.625,
   "t1": 44.76563,
   "text": "ACCEPT"
  },
  {
   "id": "oneof",
   "t0": 36.09375,
   "t1": 38.67188,
   "text": "You become one of a hundred."
  },
  {
   "id": "safe",
   "t0": 45.9375,
   "t1": 49.6875,
   "text": "Accepting doesn’t make you safe."
  },
  {
   "id": "chance",
   "t0": 50.15625,
   "t1": 55.54688,
   "text": "It only gives you a chance to find out who else is awake in the silence."
  },
  {
   "id": "title",
   "t0": 57.65625,
   "t1": 60,
   "text": "THE OFFER"
  },
  {
   "id": "q",
   "t0": 58.125,
   "t1": 60,
   "text": "Do you take it?"
  }
 ],
